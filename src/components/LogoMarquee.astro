---
/**
 * "Where brothers have worked" — an infinite, CSS-only marquee of company names
 * (or logos). Data lives in src/data/companies.json; nothing here needs editing
 * to add or remove a company. Two rows drift in opposite directions; pauses on
 * hover; with prefers-reduced-motion it becomes a static wrapping list.
 */
import { withBase } from '../lib/url';
import data from '../data/companies.json';

type Company = { name: string; logo?: string };
const companies = data.companies as Company[];
const enabled = companies.length >= 6;

// Split into two rows of roughly equal length so both loops feel full.
const half = Math.ceil(companies.length / 2);
const rows = [companies.slice(0, half), companies.slice(half)];
---
{enabled && (
  <section class="logos" aria-labelledby="logos-title">
    <div class="container logos__head">
      <p class="eyebrow reveal">{data.eyebrow}</p>
      <h2 id="logos-title" class="logos__title reveal">{data.title}</h2>
    </div>

    <div class="logos__rows reveal">
      {rows.map((row, ri) => (
        <div class={`logos__track logos__track--${ri}`}>
          {/* the list is rendered twice so the loop is seamless; the copy is aria-hidden */}
          {[0, 1].map((copy) => (
            <ul class="logos__list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {row.map((c) => (
                <li class="logos__item">
                  {c.logo ? (
                    <img src={withBase(c.logo)} alt={c.name} loading="lazy" decoding="async" />
                  ) : (
                    <span class="logos__word">{c.name}</span>
                  )}
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .logos { padding-block: clamp(3.5rem, 7vw, 5.5rem); border-bottom: 1px solid var(--line); overflow: hidden; }
  .logos__head { text-align: center; }
  .logos__title { font-size: clamp(1.2rem, 2.2vw, 1.5rem); font-weight: 500; color: var(--muted); margin: 0; }

  .logos__rows { display: grid; gap: 1.1rem; margin-top: 2.4rem; }
  .logos__track {
    display: flex; width: max-content;
    /* soft fade at both edges of the viewport */
  }
  .logos__rows {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .logos__list { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.9rem; padding-right: 0.9rem; }
  .logos__item {
    display: grid; place-items: center; height: 64px; padding: 0 1.6rem;
    border: 1px solid var(--line); border-radius: 14px; background: var(--panel);
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s;
  }
  .logos__item:hover { border-color: rgba(110, 207, 246, 0.45); }
  .logos__word {
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.01em;
    font-size: clamp(1rem, 1.6vw, 1.2rem); color: rgba(237, 247, 253, 0.82);
  }
  .logos__item:hover .logos__word { color: #fff; }
  .logos__item img { height: 28px; width: auto; max-width: 160px; opacity: 0.85; filter: brightness(0) invert(1); }
  .logos__item:hover img { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .logos__track--0 { animation: logos-l 55s linear infinite; }
    .logos__track--1 { animation: logos-r 62s linear infinite; }
    .logos__rows:hover .logos__track { animation-play-state: paused; }
    @keyframes logos-l { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @keyframes logos-r { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  }
  @media (prefers-reduced-motion: reduce) {
    /* static: drop the duplicate copy and let the list wrap */
    .logos__rows { mask-image: none; -webkit-mask-image: none; }
    .logos__track { width: auto; }
    .logos__list[aria-hidden="true"] { display: none; }
    .logos__list { flex-wrap: wrap; justify-content: center; padding-right: 0; }
  }
</style>
