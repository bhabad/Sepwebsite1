---
/**
 * "Where brothers have worked" — a single, slow, CSS-only marquee of company logos
 * that sits at the foot of the home hero. Data lives in src/data/companies.json;
 * nothing here needs editing to add or remove a company. Logos (public/logos/*.svg)
 * are rendered white; companies without a logo file fall back to a wordmark.
 * Pauses on hover; with prefers-reduced-motion it becomes a static wrapping list.
 */
import { withBase } from '../lib/url';
import data from '../data/companies.json';

type Company = { name: string; logo?: string; scale?: number; mono?: boolean };
const companies = data.companies as Company[];
const enabled = companies.length >= 6;
---
{enabled && (
  <div class="logos" aria-label={data.eyebrow}>
    <div class="logos__track">
      {/* the list is rendered twice so the loop is seamless; the copy is aria-hidden */}
      {[0, 1].map((copy) => (
        <ul class="logos__list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {companies.map((c) => (
            <li class="logos__item" title={c.name}>
              {c.logo ? (
                <img class={c.mono ? "mono" : undefined} src={withBase(c.logo)} alt={c.name} loading="lazy" decoding="async" style={c.scale ? `height:${Math.round(26*c.scale)}px` : undefined} />
              ) : (
                <span class="logos__word">{c.name}</span>
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
    <p class="logos__label">{data.eyebrow.toLowerCase()}</p>
  </div>
)}

<style>
  .logos { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.9rem; width: 100%; min-width: 0; }
  .logos__label {
    margin: 0; text-align: center;
    font-size: 0.68rem; font-weight: 400;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(143, 178, 198, 0.55);
  }

  .logos__track {
    display: flex; width: max-content;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  /* mask must be on a full-width ancestor for the edge fade to sit at the viewport edges */
  .logos { overflow: hidden; }
  .logos__list {
    list-style: none; margin: 0; padding: 0;
    display: flex; align-items: center; gap: clamp(2.2rem, 4vw, 3.6rem);
    padding-right: clamp(2.2rem, 4vw, 3.6rem);
  }
  .logos__item { display: grid; place-items: center; height: 34px; white-space: nowrap; opacity: 0.72; transition: opacity 0.2s; }
  .logos__item:hover { opacity: 1; }
  .logos__item img { height: 26px; width: auto; max-width: 150px; }
  /* marks too dark for the background render white instead of brand color */
  .logos__item img.mono { filter: brightness(0) invert(1); }
  .logos__word {
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.01em;
    font-size: 1.02rem; color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logos__track { animation: logos-l 90s linear infinite; }
    .logos:hover .logos__track { animation-play-state: paused; }
    @keyframes logos-l { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .logos__track { width: auto; mask-image: none; -webkit-mask-image: none; justify-content: center; }
    .logos__list[aria-hidden="true"] { display: none; }
    .logos__list { flex-wrap: wrap; justify-content: center; padding-right: 0; row-gap: 1rem; }
  }
</style>
