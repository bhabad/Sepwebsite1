---
import { withBase } from '../lib/url';
interface Props {
  name: string;
  linkedin?: string;
  headshot: string;
  role?: string;
}
const { name, linkedin, headshot: rawHeadshot, role } = Astro.props;
const headshot = withBase(rawHeadshot);
// One card shape for everyone: square photo, name, optional role line. The whole
// card links to LinkedIn when we have one; otherwise it is plain text.
const Tag = linkedin ? 'a' : 'div';
const linkProps = linkedin ? { href: linkedin, target: '_blank', rel: 'noreferrer noopener', 'aria-label': `${name} on LinkedIn` } : {};
---
<Tag class="member" {...linkProps}>
  <span class="member__photo">
    <img src={headshot} alt={`Headshot of ${name}`} width="400" height="400" loading="lazy" decoding="async" />
  </span>
  <span class="member__name">{name}</span>
  {role && <span class="member__role">{role}</span>}
</Tag>

<style>
  .member { display: block; text-decoration: none; color: var(--ink); }
  .member__photo { display: block; aspect-ratio: 1; overflow: hidden; background: var(--tint); }
  .member__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .member__name { display: block; margin-top: 0.55rem; font-size: 0.95rem; font-weight: 500; line-height: 1.3; }
  a.member:hover .member__name { text-decoration: underline; text-underline-offset: 0.16em; }
  .member__role { display: block; font-size: 0.85rem; color: var(--ink-2); margin-top: 0.1rem; }
</style>
