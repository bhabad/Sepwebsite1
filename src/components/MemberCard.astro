---
import { withBase } from '../lib/url';
interface Props {
  name: string;
  linkedin: string;
  headshot: string;
  role?: string;
}
const { name, linkedin, headshot: rawHeadshot, role } = Astro.props;
const headshot = withBase(rawHeadshot);
---
<a class="member" href={linkedin} target="_blank" rel="noreferrer noopener" aria-label={`${name} on LinkedIn`}>
  <span class="member__photo">
    <img src={headshot} alt={`Headshot of ${name}`} width="400" height="400" loading="lazy" decoding="async" />
  </span>
  <span class="member__name">{name}</span>
  {role && <span class="member__role">{role}</span>}
</a>

<style>
  /* same pattern as the original site: headshot, blue name, click through to LinkedIn */
  .member { display: block; text-decoration: none; text-align: center; }
  .member__photo {
    display: block; aspect-ratio: 1; overflow: hidden;
    border-radius: 12px; background: var(--panel);
  }
  .member__photo img {
    width: 100%; height: 100%; object-fit: cover; object-position: center;
    transition: transform 0.35s ease, filter 0.35s ease;
    filter: saturate(0.96);
  }
  .member:hover .member__photo img { transform: scale(1.04); filter: saturate(1.05); }
  .member__name {
    display: block; margin-top: 0.65rem;
    font-family: var(--font-display); font-weight: 500; font-size: 0.97rem;
    color: var(--sky);
  }
  .member:hover .member__name { text-decoration: underline; text-underline-offset: 3px; }
  .member__role { display: block; font-size: 0.83rem; color: var(--muted); }
</style>
