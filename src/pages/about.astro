---
import Base from '../layouts/Base.astro';
import MemberCard from '../components/MemberCard.astro';
import photos from '../data/photos.json';
import execData from '../data/exec.json';
import { withBase } from '../lib/url';
---
<Base title="About" description="Sigma Eta Pi's history and mission, and the executive board leading UNC's Iota chapter.">
  <!-- One frame: title + story at the top, both photos side by side beneath -->
  <section class="intro">
    <div class="container">
      <h1 class="reveal">About</h1>
      <div class="story">
        <div class="reveal">
          <p class="eyebrow">Our history</p>
          <p class="big-text">
            Founded in 2010 at UCLA, Sigma Eta Pi is a co-ed professional fraternity dedicated
            not to setting a path for you, but to supporting you on whatever path you carve.
            The UNC chapter, the Iota chapter of Sigma Eta Pi, was established in Spring 2020.
          </p>
        </div>
        <div class="reveal">
          <p class="eyebrow">Our mission</p>
          <p class="big-text">
            To cultivate the next generation of entrepreneurs by building a strong community of
            students passionate about starting ventures, solving real-world problems, and
            making a lasting impact.
          </p>
        </div>
      </div>
      <div class="intro__photos reveal">
        <figure class="photo-xl intro__photo">
          <img src={withBase(photos.aboutHero.src)} alt={photos.aboutHero.alt} style={`object-position: ${photos.aboutHero.position}`} fetchpriority="high" />
        </figure>
        <figure class="photo-xl intro__photo">
          <img src={withBase(photos.aboutBody.src)} alt={photos.aboutBody.alt} loading="eager" decoding="async" style={`object-position: ${photos.aboutBody.position};`} />
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="exec">
    <div class="container">
      <p class="eyebrow reveal">Leadership</p>
      <h2 class="reveal">Executive board{execData.year && <span class="exec-year"> {execData.year}</span>}</h2>
      <div class="exec-grid">
        {execData.members.map((m) => (
          <div class="reveal">
            <MemberCard name={m.name} role={m.role} linkedin={m.linkedin} headshot={m.headshot} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-top: clamp(6rem, 12vh, 8rem); }
  /* tighten the gap between the photos and the exec board */
  #exec { padding-top: clamp(3rem, 6vw, 4.5rem); }
  .intro h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); margin-bottom: clamp(1.2rem, 2.5vh, 2rem); }

  .story { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .big-text { font-size: clamp(0.98rem, 1.4vw, 1.15rem); line-height: 1.55; color: var(--text); margin: 0; }

  .intro__photos {
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.9rem, 1.8vw, 1.4rem);
    margin-top: clamp(1.6rem, 3.5vh, 2.6rem);
  }
  .intro__photo { margin: 0; }  /* kill the browser's default figure side margins */
  .intro__photo img { aspect-ratio: 16 / 10; width: 100%; object-fit: cover; }

  @media (max-width: 840px) {
    .story { grid-template-columns: 1fr; gap: 1.4rem; }
    /* phones: stack the photos full-width so they stay big */
    .intro__photos { grid-template-columns: 1fr; }
    .intro__photo img { aspect-ratio: 3 / 2; }
  }
  .exec-year { color: var(--muted); font-weight: 400; }
  .exec-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.2rem 1.4rem; margin-top: 2.2rem; }
  @media (max-width: 1000px) { .exec-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 720px) { .exec-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
