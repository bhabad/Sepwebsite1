---
import Base from '../layouts/Base.astro';
import CompanyWall from '../components/CompanyWall.astro';
import site from '../data/site.json';
import photos from '../data/photos.json';
import roster from '../data/roster.json';
import rec from '../data/recruitment.json';
import { withBase } from '../lib/url';
import { describe, shortDate } from '../lib/events';

const opens = shortDate(rec.applicationWindow.opens);
const closes = shortDate(rec.applicationWindow.closes);
const firstEvent = describe(rec.events[0]);
const firstDate = firstEvent.dateLabel.split(' – ')[0];
const recruitLine = rec.applyUrl
  ? `Applications are open until ${closes}.`
  : rec.datesConfirmed
    ? `Interest events start ${firstDate}. Applications open ${opens} and close ${closes}.`
    : 'Dates are announced on Instagram and in the recruitment GroupMe.';

// active brothers only: members flagged `alumni` in roster.json don't count
const activeCount = roster.classes.reduce((n, c) => n + c.members.filter((m: { alumni?: boolean }) => !m.alumni).length, 0);
const classCount = roster.classes.length;
const NUM = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const classWord = NUM[classCount] ?? String(classCount);
---
<Base title="Home" description={`${site.tagline}. ${activeCount} active brothers, ${classWord} classes, founded 2020. Recruitment every semester.`}>
  <!-- Masthead -->
  <section class="masthead">
    <div class="container">
      <h1>Sigma Eta Pi</h1>
      <div class="grid masthead__row">
        <p class="label span-3">{site.tagline}.<br />{site.chapter.chapterLetter}, UNC-Chapel Hill.<br />Founded {site.chapter.founded}.</p>
        <div class="span-6">
          <p class="lede">{activeCount} active brothers across {classWord} classes, building ventures, careers, and each other.</p>
          <div class="btn-row masthead__cta">
            <a class="btn btn--solid" href={withBase('/recruitment/')}>Rush SEP</a>
            <a class="btn" href={withBase('/brothers/')}>Meet the brothers</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lead photograph -->
  <figure class="photo bleed lead">
    <img src={withBase(photos.homeLead.src)} alt={photos.homeLead.alt} style={`object-position: ${photos.homeLead.position}`} fetchpriority="high" />
  </figure>
  <div class="container"><p class="meta lead__cap">{photos.homeLead.alt}.</p></div>

  <!-- Recruitment -->
  <section class="section">
    <div class="container">
      <hr class="rule" />
      <div class="head recruit">
        <p class="label">{rec.cycle} recruitment</p>
        <div class="recruit__body">
          <h2>{recruitLine}</h2>
          <div class="btn-row">
            <a class="btn btn--solid" href={withBase('/recruitment/')}>Dates and details</a>
            {site.recruitmentGroupMe && <a class="btn" href={site.recruitmentGroupMe} target="_blank" rel="noreferrer noopener">Join the recruitment GroupMe</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CompanyWall />

  <!-- Second photograph -->
  <section class="section section--tight">
    <div class="container grid">
      <figure class="photo col-right">
        <img src={withBase(photos.homeSecond.src)} alt={photos.homeSecond.alt} loading="lazy" decoding="async" style={`aspect-ratio: 4 / 3; object-position: ${photos.homeSecond.position}`} />
        <figcaption>{photos.homeSecond.alt}.</figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  .masthead { padding-top: clamp(3rem, 8vw, 6rem); padding-bottom: var(--gap-s); }
  .masthead h1 { font-size: clamp(3.25rem, 14vw, 13rem); line-height: 0.9; letter-spacing: -0.035em; margin-left: -0.04em; margin-bottom: 0.08em; }
  .masthead__row { margin-top: clamp(1.6rem, 3.5vw, 3rem); row-gap: 1.2rem; }
  .masthead__cta { margin-top: 1.6rem; }

  .lead img { aspect-ratio: 16 / 7; }
  @media (max-width: 860px) { .lead img { aspect-ratio: 4 / 3; } }
  .lead__cap { margin-top: 0.7rem; }

  .recruit { padding-top: var(--gap-s); }
  .recruit__body { grid-column: 4 / -1; }
  .recruit__body h2 { max-width: 18em; }
  .recruit__body .btn-row { margin-top: 1.8rem; }
  @media (max-width: 860px) { .recruit__body { grid-column: 1 / -1; } }
</style>
