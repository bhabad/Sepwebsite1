---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import roster from '../data/roster.json';
import LogoMarquee from '../components/LogoMarquee.astro';
import Eagle3D from '../components/Eagle3D.astro';
import { withBase } from '../lib/url';


// active brothers only — members flagged `alumni` in roster.json don't count
const memberCount = roster.classes.reduce((n, c) => n + c.members.filter((m: { alumni?: boolean }) => !m.alumni).length, 0);
// mosaic tiles, spread deterministically across 5 drifting rows
const N = 28;
const tiles = Array.from({ length: N }, (_, i) => withBase(`/photos/mosaic/m${String(i).padStart(2, '0')}.webp`));
const rows = Array.from({ length: 5 }, (_, r) =>
  Array.from({ length: 7 }, (_, i) => tiles[(r * 7 + i * 5) % N]));
---
<Base title="Home" description={`${site.tagline}. ${memberCount} brothers, ${roster.classes.length} classes, founded 2020. Recruitment every semester.`}>
  <!-- Hero: tilted drifting photo mosaic, centered eagle -->
  <section class="hero" aria-label="Sigma Eta Pi at UNC">
    <div class="hero__mosaic" aria-hidden="true">
      {rows.map((row, ri) => (
        <div class={`hero__row hero__row--${ri}`}>
          {[...row, ...row].map((t) => (
            <div class="hero__tile"><img src={t} alt="" loading="eager" decoding="async" /></div>
          ))}
        </div>
      ))}
    </div>
    <div class="hero__veil"></div>
    <div class="hero__center">
      <Eagle3D class="hero__mark" width={230} height={140} />
      <div class="hero__cta">
        <a class="btn btn--sky" href={withBase('/recruitment/')}>Join SEP</a>
      </div>
    </div>
    <!-- foot of the frame: tagline, then where brothers have worked, as the gradient settles into the page -->
    <div class="hero__foot">
      <h1 class="hero__tag">{site.tagline.toLowerCase()}</h1>
      <p class="hero__affil">Kenan-Flagler affiliated</p>
      <LogoMarquee />
    </div>
  </section>

</Base>

<style>
  .hero { position: relative; height: 100svh; min-height: 620px; overflow: hidden; }
  .hero__mosaic {
    position: absolute; inset: -22%;
    display: grid; gap: clamp(0.7rem, 1.4vw, 1.2rem);
    align-content: center;
    transform: rotate(-14deg);
  }
  .hero__row { display: flex; gap: clamp(0.7rem, 1.4vw, 1.2rem); width: max-content; }
  .hero__tile {
    width: clamp(200px, 24vw, 340px);
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .hero__tile img { width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__row--0 { animation: drift-l 70s linear infinite; }
    .hero__row--1 { animation: drift-r 85s linear infinite; }
    .hero__row--2 { animation: drift-l 78s linear infinite; }
    .hero__row--3 { animation: drift-r 92s linear infinite; }
    .hero__row--4 { animation: drift-l 74s linear infinite; }
    @keyframes drift-l { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @keyframes drift-r { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  }
  .hero__veil {
    position: absolute; inset: 0;
    /* flat dark scrim; only the last stretch fades into the page background */
    background: linear-gradient(180deg, rgba(6, 18, 27, 0.48), rgba(6, 18, 27, 0.48) 68%, var(--bg) 97%);
  }
  .hero__center {
    position: absolute; inset: 0;
    display: grid; place-items: center; align-content: center; gap: 2rem;
    /* leave the bottom of the frame to the tagline + company strip */
    padding-bottom: clamp(7rem, 16vh, 10rem);
  }
  .hero__mark { position: relative; z-index: 0; }
  .hero__cta { position: relative; z-index: 1; }
  .hero__cta { display: flex; gap: 0.9rem; flex-wrap: wrap; justify-content: center; }
  .hero__foot {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.2rem, 2.4vh, 1.8rem); justify-items: stretch;
    padding-bottom: clamp(1.4rem, 3vh, 2.2rem);
  }
  .hero__affil {
    margin: calc(-1 * clamp(0.9rem, 1.8vh, 1.3rem)) 0 0; text-align: center;
    font-family: var(--font-display); font-size: 0.72rem; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  /* the tagline doubles as the page's h1 — keep it visually small */
  .hero__tag {
    margin: 0; padding-inline: var(--pad);
    font-family: var(--font-display); font-weight: 500; letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.92); font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    line-height: 1.3; text-align: center;
  }


</style>
