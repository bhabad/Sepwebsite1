---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import rec from '../data/recruitment.json';
import { withBase } from '../lib/url';
import { describe, shortDate, clock, type EventView, type Local } from '../lib/events';

const events = rec.events.map(describe);
const opens = shortDate(rec.applicationWindow.opens);
const closes = shortDate(rec.applicationWindow.closes);

// Calendar links. The Google link subscribes to the hosted .ics, so it only resolves
// once the site is deployed (Astro.site + base must be the public URL).
const icsPath = withBase('/sep-recruitment.ics');
const icsUrl = new URL(icsPath, Astro.site).href;
const googleUrl = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(icsUrl.replace(/^https?:/, 'webcal:'))}`;

const status = rec.applyUrl
  ? `Applications close ${closes}.`
  : rec.datesConfirmed
    ? `Applications open ${opens} and close ${closes}.`
    : 'Dates drop on Instagram and in the GroupMe.';

// ---- month-grid calendar ---------------------------------------------------
// Single-day occurrences land in their day box; long all-day spans (tabling)
// are left off the grid entirely.
const SHORT: Record<string, string> = {
  'Speed Dating with Brothers': 'Speed Dating',
  'Résumé Workshop & Networking Night': 'Résumé Night',
  'Application opens': 'App opens',
  'Application closes': 'App closes',
  'Decisions sent': 'Decisions',
};
interface Chip { name: string; time: string; phase: string }
const chips = new Map<string, Chip[]>(); // "m-d" -> chips
for (const e of events) {
  const isSpan = e.allDay && e.end && (e.end.m !== e.start.m || e.end.d !== e.start.d);
  if (isSpan) continue; // long spans (tabling) stay off the grid
  for (const o of e.occurrences) {
    const k = `${o.start.m}-${o.start.d}`;
    (chips.get(k) ?? chips.set(k, []).get(k)!).push({
      name: SHORT[e.name] ?? e.name,
      time: e.allDay ? '' : clock(o.start),
      phase: e.phase,
    });
  }
}
const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const year = events[0].start.y;
const months = [...new Set(events.flatMap((e) => e.occurrences.map((o) => o.start.m)))].sort((a, b) => a - b);
const dow = (y: number, m: number, d: number) => new Date(Date.UTC(y, m - 1, d)).getUTCDay();
const daysIn = (y: number, m: number) => new Date(Date.UTC(y, m, 0)).getUTCDate();
const grids = months.map((m) => {
  const cells: ({ d: number; chips: Chip[] } | null)[] = [];
  for (let i = 0; i < dow(year, m, 1); i++) cells.push(null);
  for (let d = 1; d <= daysIn(year, m); d++) cells.push({ d, chips: chips.get(`${m}-${d}`) ?? [] });
  while (cells.length % 7) cells.push(null);
  return { name: MONTH_NAMES[m - 1], cells };
});
---
<Base title="Recruitment" description={`Rush Sigma Eta Pi at UNC. ${rec.cycle} recruitment schedule and application dates.`}>
  <section class="hero-title">
    <div class="container">
      <p class="eyebrow reveal">{rec.cycle} recruitment</p>
      <h1 class="reveal">Rush SEP.</h1>
      <p class="lede reveal">{status}</p>
      <div class="hero-cta reveal">
        {rec.applyUrl
          ? <a class="btn btn--sky" href={rec.applyUrl} target="_blank" rel="noreferrer noopener">Apply</a>
          : <a class="btn btn--sky" href={site.socials.instagram} target="_blank" rel="noreferrer noopener">Follow @uncsep</a>}
        {site.recruitmentGroupMe && <a class="btn btn--ghost" href={site.recruitmentGroupMe} target="_blank" rel="noreferrer noopener">Recruitment GroupMe</a>}
      </div>
      <div class="cal__actions reveal">
        <a class="cal-btn" href={googleUrl} target="_blank" rel="noreferrer noopener">Add to Google Calendar</a>
        <a class="cal-btn" href={icsPath} download="sep-recruitment.ics">Apple / Outlook (.ics)</a>
      </div>
    </div>
  </section>

  <section class="section cal" aria-label={`${rec.cycle} recruitment calendar`}>
    <div class="container">
      {grids.map((g) => (
        <div class="cal__month reveal">
          <div class="cal__monthhead">
            <h2 class="cal__title">{g.name} {year}</h2>
          </div>
          <div class="cal__grid" role="grid" aria-label={`${g.name} ${year}`}>
            {['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map((d) => <div class="cal__dow">{d}</div>)}
            {g.cells.map((c) => c ? (
              <div class={`cal__day${c.chips.length ? ' has-events' : ''}`} role="gridcell">
                <span class="cal__num">{c.d}</span>
                {c.chips.map((ch) => (
                  <span class={`cal__chip cal__chip--${ch.phase}`}>
                    {ch.name}{ch.time && <em>{ch.time}</em>}
                  </span>
                ))}
              </div>
            ) : <div class="cal__day cal__day--pad" role="gridcell" aria-hidden="true"></div>)}
          </div>
        </div>
      ))}

    </div>
  </section>
</Base>

<style>
  .hero-title { padding-top: clamp(7rem, 14vh, 9.5rem); }
  .hero-title h1 { font-size: clamp(3rem, 8vw, 5.5rem); }
  .hero-title .lede { margin-top: 0.4rem; }
  .hero-cta { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 1.8rem; }

  .cal { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .cal__month { margin-bottom: clamp(2.4rem, 5vw, 3.6rem); }
  .cal__monthhead { display: flex; align-items: baseline; justify-content: space-between; }
  .cal__title { font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 600; margin-bottom: 0.9rem; }

  .cal__grid {
    display: grid; grid-template-columns: repeat(7, 1fr);
    border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
    background: var(--panel);
  }
  .cal__dow {
    padding: 0.55rem 0.6rem;
    font-family: var(--font-display); font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  .cal__day {
    min-height: clamp(64px, 8.5vw, 104px);
    padding: 0.45rem 0.5rem;
    border-top: 1px solid var(--line);
    display: flex; flex-direction: column; gap: 0.3rem;
  }
  /* internal grid lines without doubling borders */
  .cal__day:not(:nth-child(7n + 1)), .cal__dow:not(:nth-child(7n + 1)) { border-left: 1px solid var(--line); }
  .cal__day--pad { background: rgba(6, 18, 27, 0.45); }
  .cal__num { font-size: 0.74rem; color: var(--muted); line-height: 1; }
  .cal__day.has-events .cal__num { color: #fff; font-weight: 600; }

  .cal__chip {
    display: block; font-size: 0.74rem; line-height: 1.25; font-weight: 500;
    color: #fff; background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px; padding: 0.22rem 0.4rem;
  }
  .cal__chip em { display: block; font-style: normal; font-size: 0.66rem; color: var(--muted); }
  .cal__chip--formal { background: rgba(255, 255, 255, 0.16); border-color: rgba(255, 255, 255, 0.32); }

  .cal__actions { display: flex; gap: 0.7rem; flex-wrap: wrap; margin-top: 1rem; }
  .cal-btn {
    display: inline-flex; align-items: center;
    font-family: var(--font-display); font-weight: 600; font-size: 0.88rem;
    padding: 0.55rem 1.1rem; border-radius: 999px; text-decoration: none;
    color: #fff; border: 1px solid rgba(255, 255, 255, 0.28); background: transparent;
    transition: border-color 0.15s, background 0.15s;
  }
  .cal-btn:hover { border-color: #fff; background: rgba(255, 255, 255, 0.06); }

  /* phones: the 7-col grid gets cramped — show only days with events, as a tight list */
  @media (max-width: 640px) {
    .cal__grid { display: block; border: 0; background: none; border-radius: 0; }
    .cal__dow, .cal__day--pad, .cal__day:not(.has-events) { display: none; }
    .cal__day.has-events {
      display: flex; flex-direction: row; align-items: center; gap: 0.7rem;
      border: 1px solid var(--line) !important; border-radius: 10px; background: var(--panel);
      margin-bottom: 0.55rem; min-height: 0; padding: 0.6rem 0.75rem;
    }
    .cal__day.has-events .cal__num { font-size: 1rem; min-width: 2ch; text-align: center; }
    .cal__chip { flex: 1; }
  }
</style>
