---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import photos from '../data/photos.json';
import rec from '../data/recruitment.json';
import { withBase } from '../lib/url';
import { describe, shortDate } from '../lib/events';

const events = rec.events.map(describe);
const phases = rec.phases as Record<string, string>;
const opens = shortDate(rec.applicationWindow.opens);
const closes = shortDate(rec.applicationWindow.closes);

// Calendar links. The Google link subscribes to the hosted .ics, so it only resolves
// once the site is deployed (Astro.site + base must be the public URL).
const icsPath = withBase('/sep-recruitment.ics');
const icsUrl = new URL(icsPath, Astro.site).href;
const googleUrl = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(icsUrl.replace(/^https?:/, 'webcal:'))}`;

const status = rec.applyUrl
  ? `Applications are open and close ${closes}.`
  : rec.datesConfirmed
    ? `Applications open ${opens} and close ${closes}.`
    : 'Dates will be announced on Instagram and in the recruitment GroupMe.';
---
<Base title="Recruitment" description={`Rush Sigma Eta Pi at UNC. ${rec.cycle} recruitment schedule and application dates.`}>
  <section class="title">
    <div class="container">
      <h1>Recruitment</h1>
      <div class="grid title__row">
        <p class="label span-3">{rec.cycle}.<br />Interest events, a short application, one evening of formal recruitment.</p>
        <div class="span-6">
          <p class="lede">{status}</p>
          <div class="btn-row title__cta">
            {rec.applyUrl
              ? <a class="btn btn--solid" href={rec.applyUrl} target="_blank" rel="noreferrer noopener">Apply</a>
              : <a class="btn btn--solid" href={site.socials.instagram} target="_blank" rel="noreferrer noopener">Follow @uncsep</a>}
            {site.recruitmentGroupMe && <a class="btn" href={site.recruitmentGroupMe} target="_blank" rel="noreferrer noopener">Join the recruitment GroupMe</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Schedule: one row per event, like a listing -->
  <section class="section schedule" aria-labelledby="schedule-title">
    <div class="container">
      <hr class="rule" />
      <div class="head schedule__head">
        <p class="label">Schedule</p>
        <div class="schedule__intro">
          <h2 id="schedule-title">{rec.cycle}, in order.</h2>
          <p class="meta schedule__sub">
            All times Chapel Hill local. Add the whole schedule to your calendar:
            <a href={googleUrl} target="_blank" rel="noreferrer noopener">Google Calendar</a> or
            <a href={icsPath} download="sep-recruitment.ics">Apple / Outlook (.ics)</a>.
          </p>
        </div>
      </div>

      <ol class="rows events" aria-label={`${rec.cycle} recruitment events, in order`}>
        {events.map((e) => (
          <li class="event">
            <div class="event__date">
              <span class="event__day">{e.dateLabel}</span>
              <span class="meta">{e.whenLabel}</span>
            </div>
            <div class="event__body">
              <h3 class="event__name">{e.name}</h3>
              {e.meta && <p class="event__meta">{e.meta}</p>}
              {e.description && <p class="event__desc">{e.description}</p>}
            </div>
            <span class="event__phase meta">{phases[e.phase] ?? e.phase}</span>
          </li>
        ))}
      </ol>

      {!rec.datesConfirmed && (
        <p class="meta tbd-note">This is the usual event lineup. Exact {rec.cycle} dates, times, and venues are coming soon.</p>
      )}
    </div>
  </section>

  <section class="section section--tight">
    <div class="container grid">
      <figure class="photo col-right">
        <img src={withBase(photos.recruitment.src)} alt={photos.recruitment.alt} loading="lazy" decoding="async" style={`aspect-ratio: 3 / 2; object-position: ${photos.recruitment.position}`} />
        <figcaption>{photos.recruitment.alt}.</figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  .title { padding-top: clamp(3rem, 8vw, 6rem); padding-bottom: var(--gap-s); }
  .title__row { margin-top: clamp(1.6rem, 3.5vw, 3rem); }
  .title__cta { margin-top: 1.6rem; }

  .schedule { padding-top: 0; }
  .schedule__head { padding-top: var(--gap-s); }
  .schedule__intro { grid-column: 4 / -1; }
  .schedule__sub { margin-top: 0.8rem; max-width: 40em; }
  @media (max-width: 860px) { .schedule__intro { grid-column: 1 / -1; } }

  .events { margin-top: var(--gap-s); }
  .event {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap);
    padding-block: 1.4rem; align-items: start;
  }
  .event__date { grid-column: span 3; display: grid; gap: 0.15rem; }
  .event__day { font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.1rem); line-height: 1.05; letter-spacing: -0.01em; font-variation-settings: 'opsz' 36; }
  .event__body { grid-column: 4 / span 7; }
  .event__name { margin: 0; }
  .event__meta { margin: 0.35rem 0 0; color: var(--ink-2); font-size: 0.95rem; }
  .event__desc { margin: 0.5rem 0 0; max-width: 38em; }
  .event__phase { grid-column: 11 / -1; text-align: right; padding-top: 0.35rem; }
  @media (max-width: 860px) {
    .event { row-gap: 0.6rem; }
    .event__date, .event__body { grid-column: 1 / -1; }
    .event__phase { grid-column: 1 / -1; text-align: left; padding-top: 0; order: -1; }
  }
  .tbd-note { margin-top: 1rem; }
</style>
