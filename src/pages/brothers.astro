---
import Base from '../layouts/Base.astro';
import MemberCard from '../components/MemberCard.astro';
import roster from '../data/roster.json';

type Member = { name: string; linkedin: string; headshot: string; alumni?: boolean; classOf?: number };
type Cls = { name: string; letter: string; semester: string; members: Member[] };

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Active classes keep their non-alumni members; everyone flagged `alumni` collects at the bottom.
const classes = (roster.classes as Cls[])
  .map((c) => ({ ...c, members: c.members.filter((m) => !m.alumni) }))
  .filter((c) => c.members.length > 0);
const alumni = (roster.classes as Cls[]).flatMap((c) =>
  c.members.filter((m) => m.alumni).map((m) => ({ ...m, className: c.name, letter: c.letter })),
);
const activeCount = classes.reduce((n, c) => n + c.members.length, 0);
---
<Base title="Brothers" description={`Meet the ${activeCount} active brothers of Sigma Eta Pi at UNC, class by class, plus our alumni.`}>
  <section class="title">
    <div class="container">
      <h1>Brothers</h1>
      <div class="grid title__row">
        <p class="label span-3">{activeCount} active brothers.<br />Newest class first.</p>
        <nav class="classnav span-9" aria-label="Jump to class">
          {classes.map((c) => (
            <a href={`#${slug(c.name)}`}><span class="serif" aria-hidden="true">{c.letter}</span> {c.name}</a>
          ))}
          {alumni.length > 0 && <a href="#alumni">Alumni</a>}
        </nav>
      </div>
    </div>
  </section>

  <div class="container">
    {classes.map((c, ci) => (
      <section class="classblock" id={slug(c.name)} aria-label={`${c.name} class, ${c.semester}`}>
        <hr class="rule" />
        <div class="classblock__head">
          <span class="classblock__letter" aria-hidden="true">{c.letter}</span>
          <div>
            <h2>{c.name}</h2>
            <p class="meta">{c.semester}{ci === 0 ? '. The newest class.' : ''}</p>
          </div>
        </div>
        <div class="members">
          {c.members.map((m) => (
            <MemberCard name={m.name} linkedin={m.linkedin} headshot={m.headshot} />
          ))}
        </div>
      </section>
    ))}

    {alumni.length > 0 && (
      <section class="classblock" id="alumni" aria-label="Alumni">
        <hr class="rule" />
        <div class="classblock__head">
          <span class="classblock__letter classblock__letter--word" aria-hidden="true">ΣΗΠ</span>
          <div>
            <h2>Alumni</h2>
            <p class="meta">Graduated brothers, by class.</p>
          </div>
        </div>
        <div class="members members--alumni">
          {alumni.map((m) => (
            <MemberCard
              name={m.name}
              linkedin={m.linkedin}
              headshot={m.headshot}
              role={`${m.className}${m.classOf ? `, class of ${m.classOf}` : ''}`}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .title { padding-top: clamp(3rem, 8vw, 6rem); padding-bottom: var(--gap-s); }
  .title__row { margin-top: clamp(1.6rem, 3.5vw, 3rem); }
  .classnav { display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; align-content: start; align-items: baseline; }
  .classnav a { text-decoration: none; font-size: 0.95rem; border-bottom: 1px solid transparent; }
  .classnav a:hover { border-bottom-color: var(--ink); }
  .classnav .serif { font-size: 1.1em; }

  .classblock { scroll-margin-top: 80px; padding-bottom: var(--gap); }
  .classblock__head { display: flex; align-items: flex-start; gap: var(--col-gap); padding-top: var(--gap-s); margin-bottom: var(--gap-s); }
  .classblock__letter {
    font-family: var(--font-display); font-variation-settings: 'opsz' 72;
    font-size: clamp(4rem, 8vw, 7rem); line-height: 0.8; letter-spacing: -0.02em;
    width: 1.2em; flex: none;
  }
  .classblock__letter--word { font-size: clamp(2.2rem, 4vw, 3.2rem); width: auto; line-height: 1; padding-top: 0.2em; }
  .classblock__head h2 { font-size: clamp(2rem, 4.2vw, 3.4rem); }
  .classblock__head .meta { margin-top: 0.5rem; }

  .members { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--gap-s) var(--col-gap); }
  .members--alumni { grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 1.8rem 1.2rem; }
  @media (max-width: 1100px) { .members { grid-template-columns: repeat(4, 1fr); } .members--alumni { grid-template-columns: repeat(6, 1fr); } }
  @media (max-width: 720px)  { .members { grid-template-columns: repeat(3, 1fr); gap: 1.6rem 0.9rem; } .members--alumni { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 480px)  { .members, .members--alumni { grid-template-columns: repeat(2, 1fr); } .classblock__head { gap: 1rem; } }
</style>
