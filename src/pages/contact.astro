---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import site from '../data/site.json';
import { withBase } from '../lib/url';

type IconName = 'mail' | 'instagram' | 'linkedin' | 'tiktok' | 'groupme';
const channels: { icon: IconName; label: string; value: string; href: string; note: string }[] = [
  { icon: 'mail', label: 'Email', value: site.email, href: `mailto:${site.email}`, note: 'Recruitment, partnership, and sponsorship questions.' },
  { icon: 'instagram', label: 'Instagram', value: '@uncsep', href: site.socials.instagram, note: 'Recruitment dates and announcements are posted here first.' },
  { icon: 'linkedin', label: 'LinkedIn', value: 'UNC Sigma Eta Pi', href: site.socials.linkedin, note: 'The chapter page. Every brother’s profile is linked from the Brothers page.' },
  { icon: 'tiktok', label: 'TikTok', value: '@unc.sep', href: site.socials.tiktok, note: 'Short videos from around the chapter.' },
];
---
<Base title="Contact" description="Get in touch with Sigma Eta Pi at UNC by email, Instagram, LinkedIn, or TikTok.">
  <section class="hero-title">
    <div class="container">
      <h1 class="reveal">Contact</h1>
    </div>
  </section>

  {site.recruitmentGroupMe && (
    <section class="container">
      <a class="groupme reveal" href={site.recruitmentGroupMe} target="_blank" rel="noreferrer noopener">
        <span class="groupme__icon"><SocialIcon name="groupme" size={30} /></span>
        <span class="groupme__text">
          <span class="groupme__label">Recruiting this semester?</span>
          <span class="groupme__title">Join the recruitment GroupMe</span>
          <span class="groupme__note">Every date, room, and reminder lands here first.</span>
        </span>
        <span class="btn btn--sky groupme__btn">Join</span>
      </a>
    </section>
  )}

  <section class="section channels-section">
    <div class="container">
      <ul class="channels">
        {channels.map((c) => (
          <li class="reveal">
            <a
              href={c.href}
              target={c.href.startsWith('mailto') ? undefined : '_blank'}
              rel={c.href.startsWith('mailto') ? undefined : 'noreferrer noopener'}
            >
              <span class="channels__icon"><SocialIcon name={c.icon} size={26} /></span>
              <span class="channels__label">{c.label}</span>
              <span class="channels__value">{c.value}</span>
              <span class="channels__note">{c.note}</span>
              <span class="channels__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Base>

<style>
  .hero-title { padding-top: clamp(7rem, 14vh, 9.5rem); text-align: center; }
  .hero-title h1 { font-size: clamp(3rem, 8vw, 5.5rem); }
  .groupme {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.4rem;
    max-width: 52rem; margin: 2.4rem auto 0; padding: 1.5rem 1.6rem;
    border-radius: var(--r); text-decoration: none;
    background: var(--panel);
    border: 1px solid rgba(110, 207, 246, 0.35);
    transition: border-color 0.15s, box-shadow 0.2s, transform 0.2s;
  }
  .groupme:hover { border-color: rgba(255, 255, 255, 0.5); transform: translateY(-1px); }
  .groupme__icon {
    display: grid; place-items: center; width: 58px; height: 58px; border-radius: 14px;
    background: #fff; color: #04121B;
  }
  .groupme__text { display: grid; gap: 0.1rem; }
  .groupme__label {
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
  }
  .groupme__title { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.15rem, 2.4vw, 1.5rem); color: #fff; line-height: 1.2; }
  .groupme__note { color: var(--muted); font-size: 0.92rem; }
  @media (max-width: 600px) {
    .groupme { grid-template-columns: auto 1fr; }
    .groupme__btn { grid-column: 1 / -1; justify-self: start; }
  }

  .channels-section { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .channels { list-style: none; margin: 0 auto; padding: 0; max-width: 52rem; }
  .channels li { border-top: 1px solid var(--line); }
  .channels li:last-child { border-bottom: 1px solid var(--line); }
  .channels a {
    display: grid; grid-template-columns: 56px 130px 1fr auto; gap: 0.2rem 1.2rem;
    padding: 1.5rem 0.3rem; text-decoration: none; align-items: center;
    transition: background 0.15s;
  }
  .channels a:hover { background: rgba(110, 207, 246, 0.05); }
  .channels__icon {
    grid-row: span 2; display: grid; place-items: center;
    width: 48px; height: 48px; border-radius: 12px;
    background: var(--panel); border: 1px solid var(--line); color: #fff;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .channels a:hover .channels__icon { background: #fff; color: #04121B; border-color: #fff; }
  .channels__label {
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); align-self: end;
  }
  .channels__value { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; color: #fff; align-self: end; }
  .channels a:hover .channels__value { color: #fff; }
  .channels__note { grid-column: 3; color: var(--muted); font-size: 0.92rem; align-self: start; }
  .channels__arrow { grid-row: span 2; align-self: center; color: var(--muted); font-size: 1.3rem; }
  @media (max-width: 600px) {
    .channels a { grid-template-columns: 48px 1fr auto; gap: 0.15rem 1rem; }
    .channels__label { grid-column: 2; }
    .channels__value { grid-column: 2; }
    .channels__note { grid-column: 2; }
    .channels__icon { grid-row: span 3; }
    .channels__arrow { grid-row: span 3; }
  }

  </style>
