---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import site from '../data/site.json';
import { withBase } from '../lib/url';

type IconName = 'mail' | 'instagram' | 'linkedin' | 'tiktok' | 'groupme';
const channels: { icon: IconName; label: string; value: string; href: string; note: string }[] = [
  { icon: 'mail', label: 'Email', value: site.email, href: `mailto:${site.email}`, note: 'Recruitment, partnership, and sponsorship questions.' },
  { icon: 'instagram', label: 'Instagram', value: '@uncsep', href: site.socials.instagram, note: 'Recruitment dates and announcements are posted here first.' },
  { icon: 'linkedin', label: 'LinkedIn', value: 'UNC Sigma Eta Pi', href: site.socials.linkedin, note: 'The chapter page. Every brother is linked from the Brothers page.' },
  { icon: 'tiktok', label: 'TikTok', value: '@unc.sep', href: site.socials.tiktok, note: 'Short videos from around the chapter.' },
];
---
<Base title="Contact" description="Get in touch with Sigma Eta Pi at UNC: the recruitment GroupMe, email, Instagram, LinkedIn, or TikTok.">
  <section class="title">
    <div class="container">
      <h1>Contact</h1>
    </div>
  </section>

  {site.recruitmentGroupMe && (
    <section class="container">
      <hr class="rule" />
      <a class="groupme" href={site.recruitmentGroupMe} target="_blank" rel="noreferrer noopener">
        <span class="label groupme__label">Rushing this semester?</span>
        <span class="groupme__body">
          <span class="groupme__title">Join the recruitment GroupMe</span>
          <span class="meta">Every date, room, and reminder lands here first.</span>
        </span>
        <span class="groupme__arrow" aria-hidden="true">→</span>
      </a>
    </section>
  )}

  <section class="section channels-section">
    <div class="container">
      <ul class="rows channels">
        {channels.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.href.startsWith('mailto') ? undefined : '_blank'}
              rel={c.href.startsWith('mailto') ? undefined : 'noreferrer noopener'}
            >
              <span class="channels__label label"><SocialIcon name={c.icon} size={15} /> {c.label}</span>
              <span class="channels__body">
                <span class="channels__value">{c.value}</span>
                <span class="meta">{c.note}</span>
              </span>
              <span class="channels__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section join">
    <div class="container">
      <hr class="rule" />
      <div class="head join__head">
        <p class="label">Interested in joining?</p>
        <div class="join__body">
          <h2>Recruitment happens at the start of every semester.</h2>
          <a class="btn btn--solid" href={withBase('/recruitment/')}>Recruitment details</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .title { padding-top: clamp(3rem, 8vw, 6rem); padding-bottom: var(--gap-s); }

  /* the GroupMe row is the same shape as the channel rows, just bigger */
  .groupme {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: center;
    padding-block: clamp(1.6rem, 3vw, 2.4rem); text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .groupme__label { grid-column: span 3; }
  .groupme__body { grid-column: 4 / span 8; display: grid; gap: 0.3rem; }
  .groupme__title { font-family: var(--font-display); font-size: clamp(1.8rem, 3.6vw, 3rem); line-height: 1.05; letter-spacing: -0.015em; }
  .groupme:hover .groupme__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
  .groupme__arrow { grid-column: 12; justify-self: end; font-size: 1.6rem; }
  @media (max-width: 860px) {
    .groupme__label, .groupme__body { grid-column: 1 / -1; }
    .groupme__arrow { display: none; }
  }

  .channels-section { padding-top: var(--gap-s); }
  .channels { border-top-color: var(--rule-soft); }
  .channels a {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap);
    padding-block: 1.3rem; text-decoration: none; align-items: center;
  }
  .channels__label { grid-column: span 3; display: inline-flex; align-items: center; gap: 0.5rem; }
  .channels__body { grid-column: 4 / span 8; display: grid; gap: 0.15rem; }
  .channels__value { font-size: 1.15rem; font-weight: 500; }
  .channels a:hover .channels__value { text-decoration: underline; text-underline-offset: 0.16em; }
  .channels__arrow { grid-column: 12; justify-self: end; }
  @media (max-width: 860px) {
    .channels a { row-gap: 0.4rem; }
    .channels__label, .channels__body { grid-column: 1 / -1; }
    .channels__arrow { display: none; }
  }

  .join { padding-top: 0; }
  .join__head { padding-top: var(--gap-s); }
  .join__body { grid-column: 4 / -1; }
  .join__body h2 { max-width: 16em; }
  .join__body .btn { margin-top: 1.6rem; }
  @media (max-width: 860px) { .join__body { grid-column: 1 / -1; } }
</style>
