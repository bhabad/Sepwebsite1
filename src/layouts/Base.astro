---
import '../styles/global.css';
import SocialIcon from '../components/SocialIcon.astro';
import site from '../data/site.json';
import { withBase, stripBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}
const { title, description = `${site.tagline}. Sigma Eta Pi, Iota chapter, at UNC-Chapel Hill.` } = Astro.props;
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/brothers/', label: 'Brothers' },
  { href: '/recruitment/', label: 'Recruitment' },
  { href: '/contact/', label: 'Contact' },
];
const path = stripBase(Astro.url.pathname);
// Absolute URLs for link previews (Astro.site comes from SITE_URL / astro.config.mjs).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('/og.jpg'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.shortName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <!-- Link previews (iMessage, GroupMe, Instagram DMs, LinkedIn, Slack) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${title} · ${site.shortName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sigma Eta Pi eagle over the chapter at the Fall 2025 lake house retreat" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ${site.shortName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Literata (display; covers Greek for the class letters) + Archivo (text and interface) -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,500&family=Archivo:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <header class="nav">
      <div class="container nav__inner">
        <a href={withBase('/')} class="nav__brand" aria-label="Sigma Eta Pi at UNC, home">
          <img src={withBase('/sep-mark-ink.svg')} alt="" width="44" height="27" />
          <span class="nav__name">Sigma Eta Pi <span class="nav__at">at UNC</span></span>
        </a>
        <nav class="nav__links" aria-label="Main">
          {nav.map((n) => (
            <a href={withBase(n.href)} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <button class="nav__toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">Menu</button>
      </div>
      <nav class="nav__mobile" id="mobile-menu" aria-label="Mobile" hidden>
        {nav.map((n) => <a href={withBase(n.href)} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <div class="container">
        <hr class="rule" />
        <div class="footer__inner">
          <div class="footer__brand">
            <img src={withBase('/sep-mark-ink.svg')} alt="" width="64" height="39" />
            <p class="serif footer__name">Sigma Eta Pi at UNC</p>
            <p class="meta">{site.tagline}. {site.chapter.chapterLetter}, founded {site.chapter.founded}.</p>
          </div>
          <nav class="footer__links" aria-label="Footer">
            {nav.map((n) => <a href={withBase(n.href)}>{n.label}</a>)}
          </nav>
          <div class="footer__social">
            <a href={site.socials.instagram} target="_blank" rel="noreferrer noopener"><SocialIcon name="instagram" size={15} /> Instagram</a>
            <a href={site.socials.tiktok} target="_blank" rel="noreferrer noopener"><SocialIcon name="tiktok" size={15} /> TikTok</a>
            <a href={site.socials.linkedin} target="_blank" rel="noreferrer noopener"><SocialIcon name="linkedin" size={15} /> LinkedIn</a>
            <a href={`mailto:${site.email}`}><SocialIcon name="mail" size={15} /> {site.email}</a>
          </div>
        </div>
        <hr class="rule rule--soft" />
        <p class="footer__legal meta">© {new Date().getFullYear()} Sigma Eta Pi, Iota Chapter, UNC-Chapel Hill</p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.nav__toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        toggle.textContent = open ? 'Menu' : 'Close';
        if (menu) menu.hidden = open;
      });
    </script>

    <style>
      .nav { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 1px solid var(--rule); }
      .nav__inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
      .nav__brand { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; }
      .nav__name { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: -0.01em; line-height: 1; font-variation-settings: 'opsz' 24; }
      .nav__at { color: var(--ink-2); }
      .nav__links { display: flex; gap: clamp(1.4rem, 3vw, 2.6rem); }
      .nav__links a { font-size: 0.95rem; text-decoration: none; padding-block: 0.3rem; border-bottom: 1px solid transparent; }
      .nav__links a:hover { border-bottom-color: var(--ink-3); }
      .nav__links a[aria-current='page'] { border-bottom-color: var(--ink); }
      .nav__toggle { display: none; }
      .nav__mobile { display: none; }

      @media (max-width: 720px) {
        .nav__links { display: none; }
        .nav__toggle {
          display: inline-block; font: inherit; font-size: 0.95rem;
          background: none; border: 0; padding: 0.3rem 0; cursor: pointer; color: var(--ink);
          border-bottom: 1px solid var(--ink);
        }
        .nav__mobile { display: grid; border-top: 1px solid var(--rule); }
        .nav__mobile[hidden] { display: none; }
        .nav__mobile a {
          padding: 1rem var(--pad); text-decoration: none;
          font-family: var(--font-display); font-size: 1.4rem; border-bottom: 1px solid var(--rule-soft);
        }
        .nav__mobile a[aria-current='page'] { color: var(--ink-2); }
      }

      .footer { margin-top: var(--gap); }
      .footer__inner { display: grid; grid-template-columns: 1.6fr 1fr 1.2fr; gap: var(--col-gap); padding-block: 2.6rem; }
      .footer__name { margin: 1rem 0 0.3rem; font-size: 1.2rem; }
      .footer__links, .footer__social { display: grid; gap: 0.5rem; align-content: start; }
      .footer a { text-decoration: none; font-size: 0.95rem; }
      .footer a:hover { text-decoration: underline; }
      .footer__social a { display: inline-flex; align-items: center; gap: 0.5rem; }
      .footer__social svg { flex: none; }
      .footer__legal { padding-block: 1.1rem; }
      @media (max-width: 720px) { .footer__inner { grid-template-columns: 1fr; gap: 1.8rem; } }
    </style>
  </body>
</html>
